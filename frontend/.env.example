# API origin the frontend talks to (must include the /api suffix)
VITE_API_URL=http://localhost:5000/api

# Absolute public origin of the deployed site, NO trailing slash.
# Used for canonical/OG meta tags, sitemap.xml and robots.txt — all of which
# require absolute URLs. Set this to the real domain before deploying.
VITE_SITE_URL=http://localhost:5173

# Plausible analytics. Leave blank to disable entirely (no script is loaded).
# Set to the domain registered in your Plausible dashboard, e.g. studyhub.cm
VITE_PLAUSIBLE_DOMAIN=
