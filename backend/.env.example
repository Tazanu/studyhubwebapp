PORT=5000

# PostgreSQL. On Neon, copy BOTH strings from the dashboard's Connect dialog:
#   DATABASE_URL -> the "Pooled connection" host (contains `-pooler`)
#   DIRECT_URL   -> the same string with `-pooler` removed
# The app runs through the pooler to stay inside the free tier's connection
# limit; Prisma Migrate must bypass it, because a transaction-mode pooler
# cannot carry the session-level locks migrations need.
# Both must keep `?sslmode=require` — Neon refuses unencrypted connections.
# On a plain local server there is no pooler, so both point at the same place.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/studyhub?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/studyhub?sslmode=require

# Set to "production" on the deployed host. This is what activates the
# HTTPS redirect in src/index.js — without it the app serves plain HTTP.
NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# MeSomb payment keys
MESOMB_APPLICATION_KEY=your_mesomb_application_key
MESOMB_ACCESS_KEY=your_mesomb_access_key
MESOMB_SECRET_KEY=your_mesomb_secret_key

PAYMENT_TEST_MODE=false

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Cloudinary — file storage for note/QA/profile uploads.
# Without all three, uploads fall back to local disk (uploads/), which does not
# survive an ephemeral host. Find these at cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
