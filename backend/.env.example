PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/studyhub

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# MeSomb payment keys
MESOMB_APPLICATION_KEY=your_mesomb_application_key
MESOMB_ACCESS_KEY=your_mesomb_access_key
MESOMB_SECRET_KEY=your_mesomb_secret_key

PAYMENT_TEST_MODE=false

# CORS — comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Cloudinary — file storage for note/QA/profile uploads.
# Without all three, uploads fall back to local disk (uploads/), which does not
# survive an ephemeral host. Find these at cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
